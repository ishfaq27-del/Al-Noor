  function parseBackup(t){
    t=String(t||"").replace(/^\uFEFF/,"").trim();
    if(!t)throw new Error("empty");
    var o=JSON.parse(t);
    var d=o&&o.data&&typeof o.data==="object"?o.data:o;
    if(!d||typeof d!=="object"||!Array.isArray(d.students)||!d.records||typeof d.records!=="object"||Array.isArray(d.records))throw new Error("bad");
    if(d.classes!==undefined&&!Array.isArray(d.classes))throw new Error("bad");
    if(!d.classes)d.classes=[];
    return {d:d,saved:o&&o.saved};
  }
